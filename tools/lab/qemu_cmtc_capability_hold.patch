--- a/hw/usb/host-libusb.c
+++ b/hw/usb/host-libusb.c
@@ -36,0 +37 @@
+#include "ws73_cmtc_hold_selector.h"
@@ -107,0 +109 @@
+    bool                             test_runtime_cmtc_capability;
@@ -555,0 +558,4 @@
+        if (s->test_runtime_cmtc_capability &&
+            !ws73_test_is_cmtc_capability_reply(r->buffer, xfer->actual_length)) {
+            goto deliver_original;
+        }
@@ -1237,0 +1244 @@
+    s->test_runtime_cmtc_capability = false;
@@ -1440 +1447 @@
-                  s->test_runtime_in_error_once ||
+                  s->test_runtime_in_error_once || s->test_runtime_cmtc_capability ||
@@ -1483 +1490,2 @@
-    if (count > 2 || !s->dh || !USB_DEVICE(s)->attached ||
+    if (count > 2 || (count && s->test_runtime_cmtc_capability) ||
+        !s->dh || !USB_DEVICE(s)->attached ||
@@ -1540,0 +1549,23 @@
+}
+
+static bool usb_host_get_test_cmtc_capability(Object *obj, Error **errp)
+{
+    return USB_HOST_DEVICE(obj)->test_runtime_cmtc_capability;
+}
+
+static void usb_host_set_test_cmtc_capability(Object *obj, bool value,
+                                             Error **errp)
+{
+    USBHostDevice *s = USB_HOST_DEVICE(obj);
+    if (!s->dh || !USB_DEVICE(s)->attached ||
+        s->ddesc.idVendor != 0xffff || s->ddesc.idProduct != 0x3733 ||
+        s->allow_host_reset || s->allow_kernel_driver_detach ||
+        s->allow_one_guest_reset || s->allow_all_guest_resets ||
+        s->test_enum_reset_once || s->test_runtime_in_error_once ||
+        s->test_runtime_hold_once || s->test_runtime_held ||
+        s->test_runtime_skip_requested) {
+        error_setg(errp, "test CMTC selector requires idle attached WS73, "
+                   "reset/detach opt-outs and no frame-skip/error selector");
+        return;
+    }
+    s->test_runtime_cmtc_capability = value;
@@ -1568,0 +1600,3 @@
+    object_property_add_bool(obj, "test-runtime-cmtc-capability",
+                             usb_host_get_test_cmtc_capability,
+                             usb_host_set_test_cmtc_capability);
