#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_clean:
	$(MAKE) clean CARGO=cargo

override_dh_auto_build:
	$(MAKE) build CARGO=cargo CARGO_FLAGS='--release --workspace'

override_dh_auto_install:
	$(MAKE) install-files PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) DESTDIR=$(CURDIR)/debian/tmp

override_dh_auto_test:
	$(MAKE) test CARGO=cargo
