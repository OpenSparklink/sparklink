C RuntimeRouteRetirementWeak

(* Weak check/drop/publish control: a publisher may restore a retired route
   after gate closure and unpublication. Not an observed WS73 hardware fault. *)
{}
P0(int *closed, int *route, spinlock_t *gate, spinlock_t *routes)
{
 int r0;
 spin_lock(gate);
 r0 = READ_ONCE(*closed);
 spin_unlock(gate);
 if (r0 == 0) {
  spin_lock(routes);
  WRITE_ONCE(*route, 1);
  spin_unlock(routes);
 }
}
P1(int *closed, int *route, spinlock_t *gate, spinlock_t *routes)
{
 int r1;
 spin_lock(gate);
 WRITE_ONCE(*closed, 1);
 spin_unlock(gate);
 spin_lock(routes);
 r1 = READ_ONCE(*route);
 WRITE_ONCE(*route, 0);
 spin_unlock(routes);
}
exists (0:r0=0 /\ 1:r1=0 /\ route=1)
